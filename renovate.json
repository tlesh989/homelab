{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "platformAutomerge": true,
  "customDatasources": {
    "minecraft-bds": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/Bedrock-OSS/BDS-Versions/main/versions.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": linux.versions.{\"version\": $}}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with a '# renovate:' comment in role defaults",
      "managerFilePatterns": [
        "/^roles/[^/]+/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*\\S+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge pinning and digest updates",
      "matchUpdateTypes": [
        "pinning",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Group minor and patch updates for Terraform providers",
      "matchManagers": [
        "terraform"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "terraform minor/patch",
      "automerge": true
    },
    {
      "description": "Group minor and patch updates for Ansible Galaxy roles",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ansible-galaxy minor/patch",
      "automerge": true
    },
    {
      "description": "Group minor and patch updates for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions minor/patch",
      "automerge": true
    },
    {
      "description": "Automerge minor and patch updates for pre-commit",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit minor/patch",
      "automerge": true
    },
    {
      "description": "Group minor and patch updates for mise-managed tools",
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise minor/patch",
      "automerge": true
    }
  ]
}
