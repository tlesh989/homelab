{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "platformAutomerge": true,
  "automerge": true,
  "customDatasources": {
    "minecraft-bds": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/Bedrock-OSS/BDS-Versions/main/versions.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": linux.versions.{\"version\": $}}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with a '# renovate:' comment in role defaults",
      "managerFilePatterns": [
        "/^roles/[^/]+/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*\\S+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Tdarr server and node must run the same version",
      "matchPackageNames": [
        "haveagitgat/tdarr",
        "haveagitgat/tdarr_node"
      ],
      "groupName": "tdarr"
    },
    {
      "description": "Group minor and patch updates for Terraform providers",
      "matchManagers": [
        "terraform"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "terraform minor/patch"
    },
    {
      "description": "Group minor and patch updates for Ansible Galaxy roles",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ansible-galaxy minor/patch"
    },
    {
      "description": "Group minor and patch updates for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github-actions minor/patch"
    },
    {
      "description": "Group minor and patch updates for pre-commit",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit minor/patch"
    },
    {
      "description": "Group minor and patch updates for mise-managed tools",
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "mise minor/patch"
    },
    {
      "description": "unifly >=0.12.0 linux binaries need GLIBC_2.43; Ubuntu 24.04 (claude-code LXC, CI runners) has 2.39. Lift once upstream ships an older-glibc or musl build",
      "matchPackageNames": [
        "/unifly/"
      ],
      "allowedVersions": "<0.12.0"
    },
    {
      "description": "AutoKuma is pinned to an RC; docker versioning reads -rc.N as a compatibility suffix and would never propose the unsuffixed stable tag",
      "matchPackageNames": [
        "ghcr.io/bigboot/autokuma"
      ],
      "versioning": "semver"
    },
    {
      "description": "Terraform CLI pins (mise.toml, versions.tf required_version) must move together; last so it overrides the per-manager groups above",
      "matchDepNames": [
        "terraform",
        "hashicorp/terraform"
      ],
      "groupName": "terraform cli"
    }
  ]
}
