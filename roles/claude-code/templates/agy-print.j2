#!/usr/bin/env bash
# Managed by Ansible (roles/claude-code). Usage: agy-print <agy args...>
# Runs agy and fails on a non-answer. When headless mode auto-denies a tool permission,
# agy prints "jetski: no output produced ..." on stdout and still exits 0.
set -euo pipefail
export PATH="/home/{{ claude_code_user }}/.local/bin:/home/{{ claude_code_user }}/.local/share/mise/shims:$PATH"  # cron PATH

out=$(agy "$@")
if [[ -z "$out" || "$out" == jetski:* ]]; then
  echo "agy-print: ${out:-empty output}" >&2
  exit 1
fi
printf '%s\n' "$out"
