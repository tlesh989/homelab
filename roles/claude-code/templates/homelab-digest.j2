#!/usr/bin/env bash
# Managed by Ansible (roles/claude-code). Nightly homelab health digest:
# gather host/container health over Ansible, summarize with the Antigravity CLI
# (plan mode, read-only), push the summary to Pushover. Detection stays with
# Uptime Kuma/Beszel; this is a daily triage summary.
set -euo pipefail
export PATH="/home/{{ claude_code_user }}/.local/bin:/home/{{ claude_code_user }}/.local/share/mise/shims:$PATH"  # cron PATH
cd {{ claude_code_repo_dest }}

report=$(homelab-collect)

prompt="You are the nightly health check for a Proxmox homelab. Below is raw output from Ansible.
Write a plain-text summary under 900 characters for a phone notification: first line is
'OK' or the count of issues, then one short line per issue (host: problem: likely fix).
Flag unreachable hosts, disks >=80%, failed units, and unhealthy/exited containers.
Do not run commands or edit files.

$report"

summary=$(timeout 900 agy -p "$prompt" --mode plan --print-timeout 600s < /dev/null) || summary=""
status=0
if [[ -z "$summary" ]]; then
  summary="Homelab digest failed: agy returned nothing. Check ~/.local/state/homelab-digest.log"
  status=1
fi
echo "$(date -Is) $summary"

homelab-notify "Homelab digest" "$summary"
exit "$status"
