# Managed by Ansible — do not edit manually
services:
  tdarr-node:
    image: "{{ tdarr_node_image }}"
    container_name: tdarr-node
    restart: unless-stopped
    # AppArmor can't load the docker-default profile inside this LXC
    # (apparmor_parser requires policy admin privileges). Same fix as arr's
    # compose stack — see roles/arr/templates/docker-compose.yml.j2.
    security_opt:
      - apparmor=unconfined
    devices:
      - /dev/dri:/dev/dri
    group_add:
      - "{{ tdarr_node_render_gid }}"
    environment:
      TZ: "{{ tdarr_node_timezone }}"
      PUID: "{{ tdarr_node_puid }}"
      PGID: "{{ tdarr_node_pgid }}"
      UMASK_SET: "002"
      nodeName: "{{ tdarr_node_id }}"
      serverIP: "{{ tdarr_node_server_ip }}"
      serverPort: "{{ tdarr_node_server_port }}"
      inContainer: "true"
    volumes:
      - "{{ tdarr_node_config_path }}/configs:/app/configs"
      - "{{ tdarr_node_config_path }}/logs:/app/logs"
      - "{{ tdarr_node_media_path }}:{{ tdarr_node_media_path }}"
