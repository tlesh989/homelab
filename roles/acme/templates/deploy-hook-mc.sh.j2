#!/usr/bin/env bash
# Managed by Ansible — runs after acme.sh issues or renews {{ acme_mc_domain }}
# Pushes the renewed cert to the Minecraft host(s) and reloads (or starts) Caddy.
# See roles/minecraft (tls_proxy.yml) for the receiving side.
set -euo pipefail

log() { echo "[acme-deploy-mc] $*"; }

ssh_opts=(-i "{{ acme_deploy_key_path }}" -o StrictHostKeyChecking=accept-new -o BatchMode=yes)

# One unreachable host must not stop the push to the others; fail at the end instead.
rc=0
cert_sha=$(sha256sum "{{ acme_mc_cert_dir }}/fullchain.pem" | cut -d' ' -f1)
{% for host in acme_mc_deploy_target_hosts %}
# Daily cron re-runs this hook. Skip a host only if its last full deploy (copy, chmod, reload)
# recorded this cert AND it still has it, so a partial failure or a rebuilt host is retried.
marker="{{ acme_mc_cert_dir }}/.deployed-{{ host }}"
if [[ "$(cat "${marker}" 2>/dev/null)" == "${cert_sha}" ]] \
  && ssh "${ssh_opts[@]}" "{{ acme_mc_deploy_remote_user }}@{{ host }}" "cat {{ acme_mc_deploy_remote_tls_dir }}/fullchain.pem" 2>/dev/null \
    | cmp -s - "{{ acme_mc_cert_dir }}/fullchain.pem"; then
  log "{{ host }} already current"
elif log "pushing cert to {{ host }}" && scp "${ssh_opts[@]}" \
    "{{ acme_mc_cert_dir }}/fullchain.pem" "{{ acme_mc_cert_dir }}/privkey.pem" \
    "{{ acme_mc_deploy_remote_user }}@{{ host }}:{{ acme_mc_deploy_remote_tls_dir }}/" \
  && ssh "${ssh_opts[@]}" "{{ acme_mc_deploy_remote_user }}@{{ host }}" \
    "chmod 640 {{ acme_mc_deploy_remote_tls_dir }}/fullchain.pem {{ acme_mc_deploy_remote_tls_dir }}/privkey.pem && sudo systemctl reload-or-restart caddy"; then
  log "reloaded caddy on {{ host }}"
  echo "${cert_sha}" > "${marker}" || { log "FAILED to record deploy marker for {{ host }}"; rc=1; }
else
  log "FAILED to deploy cert to {{ host }}"
  rc=1
fi
{% endfor %}
exit "${rc}"
