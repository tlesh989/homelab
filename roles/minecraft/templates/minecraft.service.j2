[Unit]
Description=Minecraft Bedrock Dedicated Server
After=network.target

[Service]
Type=simple
User=minecraft
WorkingDirectory={{ minecraft_install_dir }}
{% if minecraft_tls_proxy %}
# Best-effort ('-'): if the IP lookup fails BDS still starts with the previous value.
ExecStartPre=-/usr/local/sbin/minecraft-udp-ports.sh
{% endif %}
ExecStart={{ minecraft_install_dir }}/bedrock_server
Restart=on-failure
RestartSec=5s
Environment=LD_LIBRARY_PATH={{ minecraft_install_dir }}

[Install]
WantedBy=multi-user.target
